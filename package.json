{
  "name": "primetime-trivia",
  "version": "0.1.0",
  "private": false,
  "description": "A local-network trivia night for clubhouses and 55+ resorts. Runs on one laptop or a Raspberry Pi. No internet required.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "primetime": "./dist/src/server/index.js"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "dev": "concurrently -n server,client -c cyan,magenta \"tsx watch src/server/index.ts\" \"vite\"",
    "fix:content": "tsx scripts/normalize-content.ts",
    "loadtest": "node scripts/loadtest.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "start": "node dist/src/server/index.js",
    "stats": "tsx scripts/content-stats.ts",
    "test": "npm run validate && npm run typecheck && tsx --test src/server/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "tsx scripts/normalize-content.ts --check && tsx scripts/validate-content.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0",
    "yaml": "^2.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.5.12",
    "concurrently": "^9.0.1",
    "playwright-core": "^1.47.2",
    "preact": "^10.24.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  },
  "keywords": [
    "trivia",
    "quiz",
    "offline",
    "local-network",
    "clubhouse",
    "party-game",
    "raspberry-pi",
    "self-hosted"
  ]
}
